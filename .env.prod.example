# ── tyto.chat client — production env. Copy to `.env`. ──

# Image version to run (pin a release tag; do NOT use "latest" in prod).
TYTO_VERSION=1.0.0-beta.1

# Public domain that serves this SPA. Enables auto-HTTPS unless BEHIND_PROXY=true.
SERVER_DOMAIN=app.example.com

# Behind an existing reverse proxy set true: serves plain HTTP (no certificates
# issued), TLS terminates at your proxy. Combine with HTTP_PORT below.
BEHIND_PROXY=false

# Domain of your core API backend (its SERVER_DOMAIN). The SPA reaches it at
# https://<API_DOMAIN>/api/server-info.
API_DOMAIN=chat.example.com

# Advanced override: full server-info URL (custom scheme or port). Takes
# precedence over API_DOMAIN.
#SERVER_INFO_URL=https://chat.example.com:8443/api/server-info

# Optional raw Caddy global options — e.g. "email you@example.com" to attach
# an ACME contact to the Let's Encrypt account (cert expiry notices). Certs
# are issued fine without it.
CADDY_GLOBAL_OPTIONS=

# Host ports the stack binds. Change when 80/443 are taken on the host — e.g.
# behind a reverse proxy set HTTP_PORT=8081 and point the proxy there.
HTTP_PORT=80
HTTPS_PORT=443
